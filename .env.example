# Copy to .env, fill in, then: set -a; source .env; set +a

MODE=paper

# Claude. Or run `ant auth login` instead of setting a key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Scheduling and per-cycle cost controls
INTERVAL_SECONDS=1800
ONLY_WHEN_US_MARKET_OPEN=true
MAX_TOOL_CALLS_PER_CYCLE=25
MAX_WEB_SEARCHES_PER_CYCLE=5

# Paper account
PAPER_START_CASH=10000
PAPER_SLIPPAGE_BPS=5

# Hard risk limits, enforced in code
MAX_TRADE_USD=1000
MAX_POSITION_PCT=15
MAX_CRYPTO_PCT=25
MAX_DAILY_LOSS_PCT=3
MAX_TRADES_PER_CYCLE=3
MAX_TRADES_PER_DAY=10
SYMBOL_COOLDOWN_MINUTES=60
MIN_CONFIDENCE=0.6
MIN_STOCK_PRICE=5
MIN_TRADE_USD=10
